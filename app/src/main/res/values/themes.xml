<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Planner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pastel_indigo</item>
        <item name="android:statusBarColor">@color/pastel_indigo</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>

    <style name="Theme.Planner" parent="Base.Theme.Planner" />

    <!-- Splash Theme: Làm ẩn splash hệ thống để hiện splash của bạn -->
    <style name="Theme.Planner.Splash" parent="Theme.SplashScreen">
        <!-- Nền tím khớp hoàn toàn với activity_splash.xml -->
        <item name="windowSplashScreenBackground">@color/pastel_indigo</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/pastel_indigo</item>

        <!-- Xóa icon Android mặc định bằng cách đặt nó thành màu trong suốt -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>

        <item name="postSplashScreenTheme">@style/Theme.Planner.Splash.Post</item>
    </style>

    <!-- Theme trung gian giữ màu tím để không bị nháy khi chuyển sang SplashActivity -->
    <style name="Theme.Planner.Splash.Post" parent="Base.Theme.Planner">
        <item name="android:windowBackground">@color/pastel_indigo</item>
        <item name="android:statusBarColor">@color/pastel_indigo</item>
    </style>

    <style name="Widget.Planner.DayChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/card_stroke</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>

    <style name="Widget.Planner.DayChip.Selected" parent="Widget.Planner.DayChip">
        <item name="chipBackgroundColor">@color/pastel_indigo</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="WhiteNumberPicker">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>