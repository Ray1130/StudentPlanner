<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header / Delete -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/btn_delete_task"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:src="@drawable/ic_delete_24"
            android:visibility="gone"
            app:tint="@color/white" />
    </RelativeLayout>

    <!-- Task Title (Common) -->
    <EditText
        android:id="@+id/et_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@null"
        android:hint="Tên công việc"
        android:textColor="@color/white"
        android:textColorHint="#BBAAF1"
        android:textSize="28sp"
        android:textStyle="bold"
        android:inputType="textCapSentences" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#40FFFFFF" />

    <!-- STEP 1: Type Selection -->
    <LinearLayout
        android:id="@+id/container_step_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn loại công việc"
            android:textColor="#D1C7F7"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rg_task_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_study"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_type_selector"
                android:text="📚 Học tập"
                android:textColor="@color/white"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_extra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_type_selector"
                android:text="🎯 Ngoại khóa"
                android:textColor="@color/white"
                android:gravity="center"
                android:padding="12dp" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/white"
            android:text="Tiếp tục"
            android:textColor="@color/primary_purple"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- STEP 2: Expanded Details -->
    <LinearLayout
        android:id="@+id/container_step_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_save_task"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/white"
            android:text="Lưu công việc"
            android:textColor="@color/primary_purple"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Mandatory Fields Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subject Row (Study Only) -->
            <LinearLayout
                android:id="@+id/row_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sort_24"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Môn học"
                    android:textColor="#D1C7F7"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_subject_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Chọn môn"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Activity Group Row (Extra Only) -->
            <LinearLayout
                android:id="@+id/row_activity_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_group_24"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Nhóm hoạt động"
                    android:textColor="#D1C7F7"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_activity_group_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Chọn nhóm"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Deadline Row (Mandatory) -->
            <LinearLayout
                android:id="@+id/row_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar_24"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Hạn chót"
                    android:textColor="#D1C7F7"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_deadline_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Trống"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Optional Section Toggle -->
        <LinearLayout
            android:id="@+id/row_optional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_toggle_optional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tùy chọn khác"
                android:textColor="#BBAAF1"
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/iv_toggle_optional"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_drop_down_24"
                app:tint="#BBAAF1" />
        </LinearLayout>

        <!-- Optional Fields Container -->
        <LinearLayout
            android:id="@+id/container_optional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Priority Row -->
            <LinearLayout
                android:id="@+id/row_priority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_priority_24"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Ưu tiên"
                    android:textColor="#D1C7F7"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_priority_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Thấp"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Reminder Row -->
            <LinearLayout
                android:id="@+id/row_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_today_24"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Nhắc nhở"
                    android:textColor="#D1C7F7"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_time_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Tắt"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <CheckBox
                    android:id="@+id/cb_reminder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Note Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_note_24"
                    app:tint="@color/white" />
                <EditText
                    android:id="@+id/et_task_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Ghi chú thêm..."
                    android:textColor="@color/white"
                    android:textColorHint="#40FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Completed Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle_24"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Đã hoàn tất"
                    android:textColor="#D1C7F7"
                    android:textSize="16sp" />
                <CheckBox
                    android:id="@+id/cb_completed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Auto-delete Row -->
        <LinearLayout
            android:id="@+id/row_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_delete_24"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Tự động xóa sau"
                android:textColor="#D1C7F7"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_expiry_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Không"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_expired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/white"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
